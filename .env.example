# URL canónica pública del dominio
NEXT_PUBLIC_SITE_URL="https://grupocoval.com.co"

# Portal de Intranet / Acceso de Empleados (Subdominio independiente futuro)
# Ejemplo producción: https://intranet.grupocoval.com.co
# Si está vacío, /intranet y el botón "Acceso Empleados" dirigen a la pasarela interna /acceso-empleados
NEXT_PUBLIC_INTRANET_URL=""

# Webhook de n8n (Server-side únicamente - nunca exponer al cliente)
N8N_WEBHOOK_URL="https://n8n.tudominio.com/webhook/grupo-coval-leads"
N8N_WEBHOOK_SECRET="TODO_cambiar_por_secreto_hmac_opcional"

# Cloudflare Turnstile (Antispam)
# Clave de prueba oficial visible de Cloudflare para desarrollo local: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_HOSTNAMES="localhost,127.0.0.1,grupocoval.com.co,www.grupocoval.com.co"

# Medición y SEO (Opcionales hasta configurar cuentas reales)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_CF_BEACON_TOKEN=""
